# ============================================
# WINE QUALITY MLOPS PLATFORM - CONFIGURATION
# ============================================

# Project Info
PROJECT_NAME=wine-quality-mlops-platform
USER_NAME=CarolynLouise-dev

# PostgreSQL Backend Store for MLflow & Airflow
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlopspassword
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# MinIO (S3-compatible artifact store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=mlflow-artifacts

# MLflow Tracking Server
MLFLOW_HOST_PORT=5050
MLFLOW_CONTAINER_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
MLFLOW_S3_IGNORE_TLS=true

# Model Serving API
API_PORT=8000
MODEL_NAME=wine_quality_model
MODEL_STAGE=Production

# Evidently AI Drift Service
EVIDENTLY_PORT=8001
EVIDENTLY_DRIFT_THRESHOLD=0.1
EVIDENTLY_MIN_SAMPLES=50

# Prometheus & Grafana Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Airflow Orchestration
AIRFLOW_PORT=8080
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
